{
  "name": "Já pagamos?",
  "short_name": "Já pagamos?",
  "description": "As contas da casa, mês a mês: checklist, contas e comprovantes.",
  "lang": "pt-BR",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0a1020",
  "theme_color": "#0a1020",
  "share_target": {
    "action": "/compartilhar",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "arquivo", "accept": ["application/pdf", ".pdf", "image/*"] }]
    }
  },
  "icons": [
    { "src": "/icones/icone-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icones/icone-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icones/icone-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
