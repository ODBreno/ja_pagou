# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API Keys / Data API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Notificações push (gere com: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=

# Só no servidor (variáveis da Vercel, nunca no front):
# VAPID_PRIVATE_KEY=      chave privada VAPID
# SUPABASE_SECRET_KEY=    sb_secret_... (ignora o RLS; usada só em api/notificacoes.ts)
# CRON_SECRET=            texto aleatório; a Vercel manda no cabeçalho do cron
